# Ignore all site specific data
.env
/web/sites/default/*.php
/web/sites/*/files
/private/
/weaver_private
/civicrm_private
robots.txt
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/web/sites/*/civicrm.settings.php

# Ignore DDEV files
.ddev
.ddev/
*.ftppass
sftp-config.json
.mysql-creds
*.sql
*.sql.gz

# Ignore all log files
*.log

# Ignore node modules
node_modules

# Ignore default text files
/CHANGELOG.txt
/COPYRIGHT.txt
/INSTALL*.txt
/LICENSE.txt
/MAINTAINERS.txt
/UPGRADE.txt
/README.txt
sites/README.txt
sites/all/modules/README.txt
sites/all/themes/README.txt
core/.gitignore

# Ignore .htaccess files
/.htaccess
/web/.htaccess
web/.htaccess
.htpasswd

# Ignore dev theme folders
.sass-cache/